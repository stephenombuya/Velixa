# ─────────────────────────────────────────────────────────────────────────────
# Velixa – Environment Variables
# Copy this file to .env and fill in your values before running docker-compose.
# NEVER commit your .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure 256-bit (64-hex-char) secret:
#   openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=velixa
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_password
MONGO_DB=velixadb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Service ports (optional overrides) ────────────────────────────────────────
# SERVICE_REGISTRY_PORT=8761
# CONFIG_SERVER_PORT=8888
# AUTH_SERVICE_PORT=8081
# WORKSPACE_SERVICE_PORT=8082
# ACTIVITY_SERVICE_PORT=8083
# API_GATEWAY_PORT=8080
# FRONTEND_PORT=3000
